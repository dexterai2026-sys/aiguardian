{
  "manifest_version": 3,
  "name": "Guardian",
  "version": "0.0.1",
  "description": "Detects personal info and hidden prompt-injection content before it reaches an AI, entirely on your device.",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "options_page": "src/options/index.html",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*"],
      "js": ["src/content-scripts/probe.ts"]
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://character.ai/*",
        "https://beta.character.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://you.com/*",
        "http://localhost/*"
      ],
      "js": ["src/content-scripts/generic-fallback.ts"]
    }
  ]
}
